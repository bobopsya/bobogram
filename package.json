{
  "name": "bobogram",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "format": "prettier --write .",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bobogram \"vitest run -c vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore,database --project demo-bobogram",
    "dev:emu": "VITE_USE_EMULATORS=true vite",
    "test:e2e": "firebase emulators:exec --only auth,firestore,database --project demo-bobogram \"playwright test\""
  },
  "dependencies": {
    "emoji-picker-element": "^1.29.1",
    "firebase": "^12.19.0",
    "i18next": "^26.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.31.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
